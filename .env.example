# Pre-Hospital Care System - Environment Configuration Template
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control

# Database Configuration
DB_HOST=localhost
DB_NAME=pre_hospital_db
DB_USER=root
DB_PASS=

# reCAPTCHA Keys (get from https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Encryption Key (generate with: php -r "echo bin2hex(random_bytes(32));")
APP_ENCRYPTION_KEY=

# Application Settings
# Options: development, production
APP_ENV=development

# Canonical application URL. Use the real HTTPS URL in production.
APP_URL=http://localhost/prehospital

# Native Flutter authentication secret. Generate a unique value for each environment.
FLUTTER_APP_KEY=

# WebAuthn settings. On localhost, the application uses the localhost defaults.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost

# Set true only when the application is directly behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Optional local/offline mode. It disables integrations that require internet access.
OFFLINE_MODE=false
